<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SosLan.Views.LicenseExpiredWindow"
        Title="Licence expirée - SOS-LAN"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        ShowInTaskbar="True">
    <StackPanel Margin="20">
        <TextBlock Text="Licence expirée" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12"
                   Text="La licence de ce poste a expiré. Si elle a été prolongée, cliquez sur Réessayer ; sinon saisissez une autre licence." />

        <TextBlock x:Name="MessageText"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button x:Name="QuitButton" Content="Quitter" Padding="16,6" Click="OnQuitClick" />
            <Button x:Name="OtherButton" Content="Saisir une autre licence" Padding="16,6" Click="OnOtherClick" />
            <Button x:Name="RetryButton" Content="Réessayer" Padding="16,6" Click="OnRetryClick" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
