<Window x:Class="SosLan.Views.AlarmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alerte"
        Height="250" Width="420"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ShowInTaskbar="True"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow"
        Background="#B00020">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="ALERTE"
                       FontSize="24" FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,10" />
            <TextBlock x:Name="MessageText"
                       FontSize="16"
                       Foreground="White"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       HorizontalAlignment="Center" />
        </StackPanel>

        <Button Grid.Row="1"
                Content="Acquitter"
                FontSize="16"
                Padding="20,8"
                HorizontalAlignment="Center"
                Click="OnAcknowledgeClick" />

        <TextBlock x:Name="TriggeredAtText"
                   Grid.Row="2"
                   FontSize="11"
                   Foreground="#FFDDDD"
                   HorizontalAlignment="Center"
                   Margin="0,10,0,0" />
    </Grid>
</Window>
