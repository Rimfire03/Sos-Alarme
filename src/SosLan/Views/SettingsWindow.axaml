<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SosLan.Views.SettingsWindow"
        Title="Paramètres - SOS-LAN"
        Width="380"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        ShowInTaskbar="True">
    <StackPanel Margin="16">
        <TextBlock Text="Nom affiché sur le réseau" Margin="0,0,0,4" />
        <TextBox x:Name="DisplayNameBox" Margin="0,0,0,12" />

        <TextBlock Text="Touche déclenchant l'alerte" Margin="0,0,0,4" />
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
            <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="3" Padding="8,6">
                <TextBlock x:Name="HotKeyText" VerticalAlignment="Center" />
            </Border>
            <Button x:Name="ChangeKeyButton"
                    Grid.Column="1"
                    Content="Modifier"
                    Padding="14,6"
                    Margin="8,0,0,0"
                    Click="OnChangeKeyClick" />
        </Grid>

        <TextBlock Text="Durée de l'appui requise (secondes)" Margin="0,0,0,4" />
        <TextBox x:Name="DurationBox" Margin="0,0,0,12" />

        <TextBlock Text="Port réseau (identique sur tous les postes)" Margin="0,0,0,4" />
        <TextBox x:Name="PortBox" Margin="0,0,0,12" />

        <TextBlock Text="Durée maximale du signal sonore (secondes)" Margin="0,0,0,4" />
        <TextBox x:Name="MaxAlertDurationBox" Margin="0,0,0,12" />

        <CheckBox x:Name="StartWithWindowsCheckBox"
                  Content="Démarrer automatiquement avec le système"
                  Margin="0,0,0,12" />

        <TextBlock x:Name="ErrorText"
                   Foreground="Red"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="Annuler" Padding="16,6" Click="OnCancelClick" />
            <Button Content="Enregistrer" Padding="16,6" Click="OnSaveClick" IsDefault="True" />
        </StackPanel>

        <TextBlock x:Name="VersionText"
                   Margin="0,16,0,0"
                   FontSize="11"
                   Foreground="Gray"
                   HorizontalAlignment="Center" />
    </StackPanel>
</Window>
