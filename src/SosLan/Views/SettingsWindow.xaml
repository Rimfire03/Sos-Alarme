<Window x:Class="SosLan.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Paramètres - SOS-LAN"
        Width="380"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True">
    <StackPanel Margin="16">
        <TextBlock Text="Nom affiché sur le réseau" Margin="0,0,0,4" />
        <TextBox x:Name="DisplayNameBox" Margin="0,0,0,12" />

        <TextBlock Text="Touche déclenchant l'alerte" Margin="0,0,0,4" />
        <TextBox x:Name="HotKeyBox"
                 IsReadOnly="True"
                 Focusable="True"
                 Text="Cliquez ici puis appuyez sur une touche"
                 PreviewKeyDown="OnHotKeyPreviewKeyDown"
                 Margin="0,0,0,12" />

        <TextBlock Text="Durée de l'appui requise (secondes)" Margin="0,0,0,4" />
        <TextBox x:Name="DurationBox" Margin="0,0,0,12" />

        <TextBlock Text="Port réseau (identique sur tous les postes)" Margin="0,0,0,4" />
        <TextBox x:Name="PortBox" Margin="0,0,0,12" />

        <CheckBox x:Name="StartWithWindowsCheckBox"
                  Content="Démarrer automatiquement avec Windows"
                  Margin="0,0,0,12" />

        <TextBlock x:Name="ErrorText"
                   Foreground="Red"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Annuler" Padding="16,6" Margin="0,0,8,0" Click="OnCancelClick" />
            <Button Content="Enregistrer" Padding="16,6" Click="OnSaveClick" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
